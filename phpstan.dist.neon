includes:
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon

parameters:
    level: 5
    paths:
        - src
    ignoreErrors:
        -
            # the $action argument has always been ignored: using it would change existing pages (planned for 4.0)
            identifier: constructor.unusedParameter
            path: src/Components/MassAction.php
            count: 1
