<?xml version="1.0" encoding="UTF-8"?>

<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         bootstrap="vendor/autoload.php"
         failOnRisky="true"
         failOnWarning="true"
>
    <php>
        <ini name="error_reporting" value="-1" />
        <!-- Any deprecation fails the suite; set to "disabled" locally to inspect output without failing -->
        <env name="SYMFONY_DEPRECATIONS_HELPER" value="max[total]=0" />
        <env name="DOCTRINE_DEPRECATIONS" value="trigger" />
        <server name="KERNEL_CLASS" value="Kilik\TableBundle\Tests\App\TestKernel" />
        <!-- DBAL URL used by integration tests; defaults to an in-memory SQLite database -->
        <env name="KILIK_TEST_DATABASE_URL" value="sqlite:///:memory:" />
    </php>

    <testsuites>
        <testsuite name="Kilik Table Bundle Test Suite">
            <directory>./tests/</directory>
        </testsuite>
    </testsuites>

    <coverage>
        <include>
            <directory>./src/</directory>
        </include>
        <exclude>
            <directory>./src/Resources</directory>
        </exclude>
    </coverage>

    <listeners>
        <listener class="Symfony\Bridge\PhpUnit\SymfonyTestsListener">
            <arguments>
                <array>
                    <element key="time-sensitive"><string>Kilik\Table</string></element>
                </array>
            </arguments>
        </listener>
    </listeners>
</phpunit>
