{# @KilikTable/_columnFilter.html.twig #}
{% set filterLabel = column.label %}
{% if column.translateDomain is not null %}
    {% set filterLabel = (column.label | trans({}, column.translateDomain)) %}
{% endif %}
<td data-column="{{ column.name }}"{% if column.filterClass is not null %} class="{{ column.filterClass }}"{% endif %}  data-label="{{ filterLabel }}">
    {% if column.filter is not null %}
        {{ form_widget(attribute(table.formView,column.filter.name ),{"attr": {"class": "form-control refreshOnKeyup refreshOnChange","data-column": column.name} }) }}
    {% endif %}
</td>
